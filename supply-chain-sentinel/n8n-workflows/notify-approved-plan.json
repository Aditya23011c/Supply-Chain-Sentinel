      "webhookId": "27bf09a3-e3d9-5d8f-b9db-0ea4fa9a34bd"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst t = b.terms || {};\nconst lead = Number(t.lead_time_days || 0);\nconst eta = new Date(Date.now() + lead * 86400000).toISOString().slice(0, 10);\nconst po = 'PO-' + new Date().toISOString().slice(0, 10).replace(/-/g, '') + '-' + String(b.plan_id || 'x').slice(-4).toUpperCase();\nconst supplier = t.supplier || b.supplier;\nreturn [{ json: { plan_id: b.plan_id, po_number: po, supplier, quantity: t.quantity, unit_price: t.unit_price, total_cost: t.total_cost,\n  expected_delivery: eta, override: !!b.override,\n  summary: 'Purchase order ' + po + ': ' + t.quantity + ' units from ' + supplier + ', delivery by ' + eta } }];"
      },
      "id": "e9a837b1-1582-50e1-a0f1-32e762fb021b",
      "name": "Build purchase order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        270,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.callback_base + '/webhooks/n8n/plan-approved' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ...$json, execution_id: String($execution.id) }) }}",
        "options": {
          "timeout": 6000
        }
      },
      "id": "ce929150-dab5-50f4-8f68-fc103cb1dac3",
      "name": "Notify backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nconst po = $('Build purchase order').first().json;\nreturn [{ json: { ok: true, workflow: 'notify-approved-plan', executionId: String($execution.id), plan_id: b.plan_id, po_number: po.po_number } }];"
      },
      "id": "aff1148f-bbbe-5a46-b63c-8304d65c1168",
