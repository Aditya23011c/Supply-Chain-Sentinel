        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nconst c = $('Compose email').first().json;\nreturn [{ json: { ok: true, workflow: 'send-outreach', executionId: String($execution.id), plan_id: b.plan_id, delivered_to: c.to } }];"
      },
      "id": "c87e287d-142f-570e-a7c6-1e664a94520e",
