    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst lines = String(b.draft || '').split('\\n');\nconst subject = (lines[0] || '').replace(/^Subject:\\s*/i, '').trim();\nconst body = lines.slice(1).join('\\n').trim();\nconst t = b.terms || {};\nconst slug = String(t.supplier || 'supplier').toLowerCase().replace(/[^a-z0-9]+/g, '');\nreturn [{ json: { plan_id: b.plan_id, attempt: b.attempt, supplier: t.supplier, to: 'sales@' + slug + '.example', subject, body, sent_at: new Date().toISOString() } }];"
      },
      "id": "90a146c5-9168-5291-83d4-3a2001d0bab7",
      "name": "Compose email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        270,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.callback_base + '/webhooks/n8n/outreach-sent' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ plan_id: $json.plan_id, attempt: $json.attempt, supplier: $json.supplier, to: $json.to, subject: $json.subject, execution_id: String($execution.id) }) }}",
        "options": {
          "timeout": 6000
        }
      },
      "id": "aaea3086-a67e-53c1-988f-1bf3e8fcf0e4",
      "name": "Deliver to supplier inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
